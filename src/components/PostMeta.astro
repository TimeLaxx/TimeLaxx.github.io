---
interface Props {
  date: Date;
  tags?: string[];
  category?: string;
  readingTime?: string;
}

const { date, tags, category, readingTime } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-muted)] mb-8 pb-6 border-b border-[var(--color-border)]">
  <time datetime={date.toISOString()}>
    {date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
  </time>
  {readingTime && (
    <>
      <span>·</span>
      <span>{readingTime}</span>
    </>
  )}
  {category && (
    <>
      <span>·</span>
      <a href={`/categories/${category}`} class="text-[var(--color-primary)] hover:text-[var(--color-primary-dark)]">
        {category}
      </a>
    </>
  )}
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a href={`/tags/${tag}`} class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg)] hover:text-[var(--color-primary)] transition-colors">
          #{tag}
        </a>
      ))}
    </div>
  )}
</div>

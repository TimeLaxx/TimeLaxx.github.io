---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="mb-12">
  <h1 class="text-2xl font-bold text-[var(--color-text)]">{title}</h1>
  {description && (
    <p class="mt-2 text-[var(--color-text-muted)]">{description}</p>
  )}
</section>

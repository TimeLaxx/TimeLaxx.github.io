---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const tags = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tags.set(tag, (tags.get(tag) || 0) + 1);
  }
}
const sorted = [...tags.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={`标签 - ${SITE.title}`} description="文章标签">
  <h1 class="text-2xl font-bold mb-8">标签</h1>

  <div class="flex flex-wrap gap-2">
    {sorted.map(([tag, count]) => (
      <a href={`/tags/${tag}`} class="px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)] transition-all">
        {tag} <span class="text-xs">({count})</span>
      </a>
    ))}
  </div>

  {sorted.length === 0 && (
    <p class="text-[var(--color-text-muted)] text-center py-12">暂无标签。</p>
  )}
</BaseLayout>

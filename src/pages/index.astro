---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../consts";

const posts = await getCollection("posts", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Hero -->
  <section class="mb-12">
    <h1 class="text-3xl font-bold text-[var(--color-text)]">{SITE.title}</h1>
    <p class="mt-2 text-[var(--color-text-muted)] text-lg">{SITE.description}</p>
  </section>

  <!-- Posts -->
  <div class="flex flex-col gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  {posts.length === 0 && (
    <p class="text-[var(--color-text-muted)] text-center py-12">还没有文章，敬请期待。</p>
  )}
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";

const posts = await getCollection("posts", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group by year
const byYear: Record<number, typeof posts> = {};
for (const post of posts) {
  const y = post.data.date.getFullYear();
  (byYear[y] ??= []).push(post);
}
---

<BaseLayout title={`归档 - ${SITE.title}`} description="文章归档">
  <h1 class="text-2xl font-bold mb-8">归档</h1>

  {Object.entries(byYear).sort(([a], [b]) => +b - +a).map(([year, yearPosts]) => (
    <section class="mb-8">
      <h2 class="text-lg font-semibold mb-3 text-[var(--color-text)]">{year}</h2>
      <ul class="space-y-2">
        {yearPosts.map((post) => (
          <li class="flex items-baseline gap-4">
            <time class="text-xs text-[var(--color-text-muted)] w-20 shrink-0 text-right">
              {post.data.date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
            </time>
            <a href={`/posts/${post.slug}`} class="text-sm hover:text-[var(--color-primary)] transition-colors">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

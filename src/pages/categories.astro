---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";

const posts = await getCollection("posts", ({ data }) => !data.draft);

// Count by category
const categories = new Map<string, number>();
for (const post of posts) {
  const cat = post.data.category;
  if (cat) {
    categories.set(cat, (categories.get(cat) || 0) + 1);
  }
}
const sorted = [...categories.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={`分类 - ${SITE.title}`} description="文章分类">
  <h1 class="text-2xl font-bold mb-8">分类</h1>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    {sorted.map(([cat, count]) => (
      <a href={`/categories/${cat}`} class="border border-[var(--color-border)] rounded-lg p-4 bg-[var(--color-surface)] hover:shadow-md hover:text-[var(--color-primary)] transition-all">
        <div class="font-medium text-[var(--color-text)]">{cat}</div>
        <div class="text-xs text-[var(--color-text-muted)] mt-1">{count} 篇</div>
      </a>
    ))}
  </div>

  {sorted.length === 0 && (
    <p class="text-[var(--color-text-muted)] text-center py-12">暂无分类。</p>
  )}
</BaseLayout>

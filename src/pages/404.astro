---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-[var(--color-text-muted)]">404</h1>
    <p class="mt-4 text-[var(--color-text-muted)]">你找的页面不存在。</p>
    <a href="/" class="inline-block mt-6 px-4 py-2 rounded-lg bg-[var(--color-primary)] text-white text-sm hover:bg-[var(--color-primary-dark)] transition-colors">
      返回首页
    </a>
  </div>
</BaseLayout>

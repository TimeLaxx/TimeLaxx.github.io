---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIAL } from "../consts";
---

<BaseLayout title={`关于 - ${SITE.title}`} description="关于我">
  <h1 class="text-2xl font-bold mb-6">关于</h1>

  <div class="prose">
    <p>
      你好，我是 <strong>{SITE.author}</strong>，一名开发者。
    </p>
    <p>
      这里是我的个人技术博客，记录学习、思考和项目实践。
    </p>
    <p>
      你可以通过以下方式找到我：
    </p>
    <ul>
      <li><a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub: TimeLaxx</a></li>
      <li><a href="/rss.xml">RSS 订阅</a></li>
    </ul>
  </div>
</BaseLayout>
